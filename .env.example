# Placeholders only. Generate real values in your secret store.
#   openssl rand -hex 32

# Discord application → Bot → Token
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
# Server (guild) snowflake
DISCORD_GUILD_ID=000000000000000000
# Private staff text channel or forum channel where submission threads are created
DISCORD_CHANNEL_ID=000000000000000001
# Private channel that mirrors the append-only audit log
DISCORD_AUDIT_CHANNEL_ID=000000000000000002
# Private channel for heartbeats, watchdog alerts, and bad-signature bursts
DISCORD_ADMIN_CHANNEL_ID=000000000000000003
# Comma-separated Discord user snowflakes allowed to run /reply /note /status /open
ALLOWLIST_USER_IDS=000000000000000010,000000000000000011

# Grok Bot webhook URL for the "Mantis action" routine. The path is a credential.
ACTION_WEBHOOK_URL=https://example.invalid/hooks/replace-with-webhook-id
# HMAC-SHA256 key for Discord → Triage envelopes. UTF-8 string, 32+ characters.
ACTION_HMAC_SECRET=replace-with-openssl-rand-hex-32
# Optional second key accepted by Triage during rotation. The bot signs with the current key.
ACTION_HMAC_SECRET_NEXT=

# HMAC-SHA256 key for Triage → Discord relay requests. Different secret from ACTION_HMAC_SECRET.
RELAY_HMAC_SECRET=replace-with-a-different-openssl-rand-hex-32
RELAY_HMAC_SECRET_NEXT=

RELAY_HOST=0.0.0.0
RELAY_PORT=8787
DATABASE_PATH=./data/bot.sqlite
# Used only to build "view in Mantis" links. Not a credential.
MANTIS_APP_URL=https://mantis.example.invalid

LOG_LEVEL=info
# HEARTBEAT_INTERVAL_MS=3600000
# DELIVERY_TIMEOUT_MS=30000
